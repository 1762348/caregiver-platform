# ============================================================
# 优护 · 社区护工预约平台 环境变量样例
# 复制为 .env 后修改；.env 已在 .gitignore 中忽略
# ============================================================

# ---------- Docker Compose ----------
# MySQL root 密码（必填，建议 16 位以上随机串）
DB_PASSWORD=please-change-me

# JWT 签名密钥（必填，至少 32 字节）
# 生成方式：openssl rand -base64 48
JWT_SECRET=please-run-openssl-rand-base64-48

# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# 验证码：生产必须留空（随机码输出到日志）；仅本地演示可设为 123456
SMS_FIXED_CODE=

# 对外访问地址，用于 CORS（例如 https://caregiver.example.com）
PUBLIC_ORIGIN=http://localhost

# Mock 支付回调签名密钥
MOCK_PAYMENT_SECRET=please-change-me

# ---------- 本地开发（不走 Docker 时） ----------
# DB_URL=jdbc:mysql://localhost:3306/caregiver_platform?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=123456
# SERVER_PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
