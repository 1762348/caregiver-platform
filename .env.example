# 环境变量示例
# 复制为 .env（本地）或写入部署环境；.env 已在 .gitignore 中忽略

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://localhost:3306/caregiver_platform?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ---------- 应用 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- JWT（P2 启用）----------
JWT_SECRET=please-replace-with-a-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=10080

# ---------- 短信（开发环境固定验证码）----------
SMS_FIXED_CODE=123456

# ---------- 跨域 ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 前端 ----------
VITE_API_BASE_URL=/api
